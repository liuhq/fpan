# PostgreSQL connection used for metadata.
FPAN_DATABASE_URL=postgres://fpan:change-me@localhost:5432/fpan?sslmode=disable

# Local directory used for physical blob storage.
FPAN_STORAGE_PATH=./storage

# Authentication mode. The default is oidc; mock is limited to loopback development.
FPAN_AUTH_MODE=oidc

# OpenID Connect provider and client registration.
FPAN_OIDC_ISSUER=https://id.example.com
FPAN_OIDC_CLIENT_ID=fpan
FPAN_OIDC_CLIENT_SECRET=change-me
# During frontend development, point the callback at the Vite origin so /api is proxied.
FPAN_OIDC_REDIRECT_URL=http://localhost:5173/api/v1/auth/callback

# HTTP listener. The Vite development server proxies /api to this address.
FPAN_LISTEN_ADDR=:6313

# Optional maintenance and HTTP timeout settings.
FPAN_GC_INTERVAL=1h
FPAN_GC_GRACE_PERIOD=24h
FPAN_GC_BATCH_SIZE=100
FPAN_HTTP_READ_HEADER_TIMEOUT=5s
FPAN_HTTP_IDLE_TIMEOUT=1m
FPAN_HTTP_SHUTDOWN_TIMEOUT=10s
