{
  "name": "@fpan/api",
  "version": "0.1.0",
  "exports": {
    ".": "./app.ts"
  },
  "tasks": {
    "dev": "deno run -A --env-file main.ts",
    "build": "deno compile main.ts",
    "db:generate": "deno run -A --env-file drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "deno run -A --env-file scripts/migrate.ts",
    "db:studio": "deno run -A --env-file drizzle-kit studio --config drizzle.config.ts"
  },
  "compilerOptions": {
    "lib": ["deno.ns", "deno.worker", "esnext"],
    "noUncheckedIndexedAccess": true
  },
  "imports": {
    "#db/": "./db/",
    "#dir": "./dir/index.ts",
    "#errors": "./errors.ts",
    "#services/": "./services/",
    "@hono/zod-validator": "npm:@hono/zod-validator@^0.8.0",
    "@libsql/client": "npm:@libsql/client@^0.17.3",
    "drizzle-kit": "npm:drizzle-kit@^0.31.10",
    "drizzle-orm": "npm:drizzle-orm@^0.45.2",
    "nanoid": "npm:nanoid@^5.1.11",
    "zod": "npm:zod@^4.4.3"
  }
}
