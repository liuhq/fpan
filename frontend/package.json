{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "dev:mock": "react-router dev --mode mock",
    "start": "react-router-serve ./build/server/index.js",
    "typegen": "react-router typegen",
    "check": "pnpm run api:check && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run build",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "react-router typegen && tsc",
    "api:generate": "node scripts/generate-openapi.js",
    "api:check": "node scripts/generate-openapi.js --check",
    "api:docs": "scalar document serve ../api/openapi.yaml --watch --port 6314"
  },
  "dependencies": {
    "@react-router/node": "^8",
    "@react-router/serve": "^8",
    "isbot": "^5.1.36",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@react-router/dev": "^8",
    "@scalar/cli": "^2.1.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "daisyui": "^5.7.23",
    "msw": "^2.14.6",
    "openapi-msw": "^2.0.0",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
